# Copia este archivo a backend/.env (o exporta estas variables) y completa.
# NUNCA subas .env al repositorio.

# --- Base de datos (obligatorio en producción) ---
DB_HOST=localhost
DB_NAME=posters
DB_USER=posters_app
DB_PASS=

# --- Tokens (obligatorio en producción) ---
# Generar: openssl rand -hex 32
AUTH_SECRET=

# --- Almacenamiento de pósters (obligatorio en producción) ---
# Ruta absoluta FUERA del checkout de git
UPLOAD_DIR=/srv/posters-uploads
# Prefijo público desde el que se sirve UPLOAD_DIR
PUBLIC_FILES_URL=/imgPosters

# --- CORS ---
# Orígenes permitidos, separados por coma
CORS_ORIGINS=http://localhost:5173

# --- SMTP (solo si se envía correo) ---
# Dominio institucional: campusucc.edu.co (pedir host/puerto/usuario a TI)
# SMTP_HOST=smtp.campusucc.edu.co
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Sistema de Pósteres

# Contraseña temporal para importación CSV de usuarios (opcional)
# PASS_TEMPORAL_IMPORT=   # si se deja vacía, se genera una aleatoria por importación

# --- Frontend (build de Vite, opcional) ---
# Por defecto la app usa rutas relativas /api y /imgPosters
# VITE_API_BASE=/api
# VITE_FILES_BASE=/imgPosters
